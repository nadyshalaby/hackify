{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.sh\" \"${CLAUDE_PLUGIN_ROOT}/rules/hard-caps.md\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.sh\" \"${CLAUDE_PLUGIN_ROOT}/rules/expert-mindset.md\""
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/inject-context.sh\" \"${CLAUDE_PLUGIN_ROOT}/rules/perf-guardrails.md\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/block-banned-tokens.sh\""
          }
        ]
      }
    ]
  }
